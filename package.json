{
  "name": "streamtv",
  "version": "3.0.0",
  "private": true,
  "description": "StreamTV — catalogue IPTV, guide de zapping, lecteur vidéo et console d’administration. Node.js natif, zéro dépendance.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "ingest": "node scripts/ingest.js",
    "measure": "node scripts/measure-tagger.js",
    "backup": "node scripts/backup.js",
    "verify": "node scripts/verify.js --base http://127.0.0.1:3000"
  },
  "dependencies": {},
  "devDependencies": {},
  "license": "UNLICENSED",
  "keywords": [
    "iptv",
    "m3u",
    "streamtv",
    "nodejs",
    "zero-dependency"
  ]
}
